// firebase.json
{
  "hosting": {
    "public": "public", // あなたの公開ディレクトリ
    "ignore": [ /* ... */ ],
    "rewrites": [ /* ... */ ],
    "headers": [
      {
        "source": "**", 
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "unsafe-none" // ★★★ 最も緩い設定 ★★★
          },
          { 
            "key": "Cross-Origin-Embedder-Policy",
            "value": "unsafe-none" // ★★★ 最も緩い設定 ★★★
          }
        ]
      }
    ]
  }
}