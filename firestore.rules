rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own data only if
    // the request comes from an authenticated user AND has a valid App Check token.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && request.app.token.app_id != null;
    }
  }
}
